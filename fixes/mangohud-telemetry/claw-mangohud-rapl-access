#!/bin/sh

set -eu

read_value()
{
	value=
	if [ -r "$1" ]; then
		IFS= read -r value < "$1" || true
	fi
	printf '%s' "$value"
}

if [ "$(read_value /sys/class/dmi/id/sys_vendor)" != \
	"Micro-Star International Co., Ltd." ] ||
   [ "$(read_value /sys/class/dmi/id/product_name)" != \
	"Claw 8 EX AI+ CG3EM" ] ||
   [ "$(read_value /sys/class/dmi/id/board_name)" != "MS-1T91" ]; then
	echo "claw-mangohud-rapl-access: unsupported DMI; no permissions changed"
	exit 0
fi

rapl_found=0
for zone in /sys/class/powercap/intel-rapl:*; do
	[ -d "$zone" ] || continue
	zone_name=$(read_value "$zone/name")
	case "$zone_name" in
		package-0|uncore) ;;
		*) continue ;;
	esac
	[ -e "$zone/energy_uj" ] || continue

	chgrp video "$zone/energy_uj"
	chmod 0440 "$zone/energy_uj"
	rapl_found=1
	echo "claw-mangohud-rapl-access: enabled video-group read access for $zone_name at $zone/energy_uj"
done

if [ "$rapl_found" -eq 0 ]; then
	echo "claw-mangohud-rapl-access: no Intel package or uncore energy counter found"
fi

pmt_found=0
for endpoint in /sys/class/intel_pmt/telem*; do
	[ -d "$endpoint" ] || continue
	guid=$(read_value "$endpoint/guid")
	case "$guid" in
		0x3086000|0x03086000) ;;
		*) continue ;;
	esac

	size=$(read_value "$endpoint/size")
	case "$size" in
		''|*[!0-9]*) continue ;;
	esac
	[ "$size" -gt 127 ] || continue
	[ -e "$endpoint/telem" ] || continue

	chgrp video "$endpoint/telem"
	chmod 0440 "$endpoint/telem"
	pmt_found=1
	echo "claw-mangohud-rapl-access: enabled video-group read access for Panther Lake telemetry at $endpoint/telem"
done

if [ "$pmt_found" -eq 0 ]; then
	echo "claw-mangohud-rapl-access: no Panther Lake normal telemetry endpoint found"
fi
