+void GPU_fdinfo::find_intel_pmt_gpu_temp()
+{
+    constexpr uint64_t ptl_normal_guid = 0x03086000;
+    constexpr uint64_t gt_max_end_offset = 127;
+    const std::string pmt_class = "/sys/class/intel_pmt";
+
+    if (read_line("/sys/class/dmi/id/sys_vendor") !=
+            "Micro-Star International Co., Ltd." ||
+        read_line("/sys/class/dmi/id/product_name") !=
+            "Claw 8 EX AI+ CG3EM" ||
+        read_line("/sys/class/dmi/id/board_name") != "MS-1T91") {
+        return;
+    }
+
+    try {
+        if (!fs::exists(pmt_class))
+            return;
+
+        for (const auto& entry : fs::directory_iterator(pmt_class)) {
+            const auto endpoint = entry.path().string();
+            const auto filename = entry.path().filename().string();
+            if (filename.rfind("telem", 0) != 0)
+                continue;
+
+            uint64_t guid = 0;
+            uint64_t size = 0;
+            try {
+                guid = std::stoull(read_line(endpoint + "/guid"), nullptr, 0);
+                size = std::stoull(read_line(endpoint + "/size"), nullptr, 0);
+            } catch (...) {
+                continue;
+            }
+
+            if (guid != ptl_normal_guid || size <= gt_max_end_offset)
+                continue;
+
+            auto stream = std::ifstream(endpoint + "/telem",
+                                        std::ios::in | std::ios::binary);
+            if (!stream.good()) {
+                SPDLOG_WARN(
+                    "intel_pmt: Panther Lake GPU temperature at {}/telem is "
+                    "not readable; enable claw-mangohud-rapl-access.service",
+                    endpoint
+                );
+                continue;
+            }
+
+            intel_pmt_gpu_temp_stream = std::move(stream);
+            intel_pmt_gpu_temp_path = endpoint + "/telem";
+            SPDLOG_DEBUG(
+                "intel_pmt: using Panther Lake GT_MAX temperature at byte {} of {}",
+                gt_max_end_offset, intel_pmt_gpu_temp_path
+            );
+            return;
+        }
+    } catch (const fs::filesystem_error& ex) {
+        SPDLOG_WARN("intel_pmt: failed to discover GPU temperature: {}", ex.what());
+    }
+}
+
+int GPU_fdinfo::get_intel_pmt_gpu_temp()
+{
+    constexpr std::streamoff gt_max_end_offset = 127;
+
+    if (!intel_pmt_gpu_temp_stream.is_open())
+        return 0;
+
+    char raw_temp = 0;
+    intel_pmt_gpu_temp_stream.clear();
+    intel_pmt_gpu_temp_stream.seekg(gt_max_end_offset, std::ios::beg);
+    intel_pmt_gpu_temp_stream.read(&raw_temp, sizeof(raw_temp));
+    if (intel_pmt_gpu_temp_stream.gcount() != sizeof(raw_temp))
+        return 0;
+
+    const int temp = static_cast<int>(static_cast<int8_t>(raw_temp));
+    return temp > 0 && temp < 125 ? temp : 0;
+}
