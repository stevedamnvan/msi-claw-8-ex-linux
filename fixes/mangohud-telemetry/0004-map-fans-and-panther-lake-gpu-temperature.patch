-   else
-      fan_speed = -1;
+   const auto read_fan_speed = [](const string& path) {
+      if (path.empty())
+         return -1;
+
+      try {
+         const auto value = read_line(path);
+         return value.empty() ? -1 : stoi(value);
+      } catch (...) {
